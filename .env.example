# Copy to .env for local development. Never commit real values.
# In AWS, workloads use IAM roles (no access keys) and read the Pinecone key from SSM.

# --- AWS (local only; prefer `aws sso login` / a named profile over static keys) ---
AWS_REGION=us-east-1
# AWS_PROFILE=dof-ai

# --- Bedrock embeddings ---
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_WORKERS=8

# --- Pinecone ---
PINECONE_API_KEY=
# Cloud alternative to PINECONE_API_KEY: name of an SSM SecureString parameter
# PINECONE_API_KEY_PARAM=/dof-ai/pinecone-api-key
PINECONE_INDEX_HOST=
# PINECONE_INDEX_NAME=dof-ai-legislacion
PINECONE_NAMESPACE=legislacion

# --- Chunking ---
MAX_CHUNK_CHARS=8000
