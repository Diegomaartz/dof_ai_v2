# Copy to .env for local development. Never commit real values.
# In AWS, workloads use IAM roles (no access keys) and read the Pinecone key from SSM.

# --- AWS (local only; prefer `aws sso login` / a named profile over static keys) ---
AWS_REGION=us-east-1
# AWS_PROFILE=dof-ai

# --- Bedrock embeddings ---
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_WORKERS=8

# --- Pinecone ---
PINECONE_API_KEY=
# Cloud alternative to PINECONE_API_KEY: name of an SSM SecureString parameter
# PINECONE_API_KEY_PARAM=/dof-ai/pinecone-api-key
PINECONE_INDEX_HOST=
# PINECONE_INDEX_NAME=dof-ai-legislacion
PINECONE_NAMESPACE=legislacion

# --- Chunking ---
MAX_CHUNK_CHARS=8000

# --- Agent (backend/agent) ---
# Bedrock model or inference-profile IDs (Claude or Amazon Nova), swappable without code changes.
# CHAT answers the user; FAST (optional, defaults to CHAT) routes, grades and rewrites queries.
BEDROCK_CHAT_MODEL_ID=
# BEDROCK_FAST_MODEL_ID=
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# AGENT_RETRIEVAL_TOP_K=6
# AGENT_MAX_RETRIES=2
# AGENT_MAX_DOF_CANDIDATES=250
# AGENT_MAX_DOF_FULL_TEXTS=2
# AGENT_DOF_TEXT_CHARS=12000
# AGENT_GRADE_EXCERPT_CHARS=1500
# AGENT_MAX_ANSWER_TOKENS=2048
# AGENT_TIMEZONE=America/Mexico_City

# --- Django API (backend/core, backend/api) ---
# DJANGO_DEBUG=true enables a throwaway dev secret key; production requires DJANGO_SECRET_KEY (Secrets Manager in AWS).
# LOCAL DEVELOPMENT ONLY: never enable it on a server.
# DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins of the React SPA allowed by CORS (defaults to the Vite dev server when DJANGO_DEBUG=true).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_BEHIND_TLS_PROXY=false
# CHAT_RATE_LIMIT=10/minute
# CHAT_MAX_QUESTION_CHARS=2000
# CHAT_MAX_BODY_BYTES=16384
# CHAT_TRUSTED_PROXY_COUNT=0   # set to 1 behind the AWS ALB
# CHAT_KEEPALIVE_SECONDS=15
# LOG_LEVEL=INFO

# --- MCP server (mcp-server/; all optional, defaults shown) ---
# DOF_MCP_SIDOF_BASE_URL=https://sidof.segob.gob.mx/dof/sidof
# DOF_MCP_PUBLIC_BASE_URL=https://dof.gob.mx
# DOF_MCP_HTTP_TIMEOUT=20
# DOF_MCP_MAX_DECREE_CHARS=60000
# DOF_MCP_TIMEZONE=America/Mexico_City
# Host-header allowlist (DNS-rebinding protection), e.g. the Lambda Function URL host. Empty = disabled.
# DOF_MCP_ALLOWED_HOSTS=xxxx.lambda-url.us-east-1.on.aws
# DOF_MCP_ALLOWED_ORIGINS=
